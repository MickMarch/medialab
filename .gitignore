# Future service dirs not yet registered as submodules
media-library/

# Python
__pycache__/
*.py[oc]
*.egg-info
.venv/
dist/
build/

# Environment
.env
.env.*
!.env.example
*.env.local

# Generated by bin/medialab-versions.sh - regenerated from submodule tags, never committed.
.versions.env

# VPN provider settings and WireGuard config for the gluetun container.
gluetun/vpn.env
gluetun/wg0.conf

# qBittorrent container state: appdata (holds the WebUI API key) and the
# operator's admin password written by bin/medialab-qbt-provision.sh.
qbittorrent/

# Legacy host-side completion-hook wrapper (held the gateway API key). Replaced
# by the curl autorun inside the qBittorrent container; kept ignored so an old
# checkout never commits it.
bin/notify-complete.bat

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Node (for any JS tooling at root)
node_modules/

# medialab-setup state: replayable non-secret answers and pre-write .env backups.
.medialab-setup/

# Written by the medialab-doctor-after-logon scheduled task; transient.
.doctor-boot.log
