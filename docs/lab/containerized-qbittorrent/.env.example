# Lab-only values. Copy to .env. Nothing here is shared with the medialab stack.

# Lab bridge subnet. gluetun must allow egress to it or qBittorrent cannot
# reach the webhook receiver. Must not overlap the WireGuard tunnel range.
LAB_SUBNET=172.30.77.0/24

# qBittorrent WebUI API key (qbt_ prefix, 32 chars). Generated in the WebUI on
# first boot (Preferences > WebUI > API Key), then pasted here for the probe.
QB_API_KEY=

# gluetun control server key, any random string. Used by the kill-switch test.
GLUETUN_CONTROL_API_KEY=

# Pinned images. qBittorrent >= 5.2 is required for API key auth.
GLUETUN_IMAGE=qmcgaw/gluetun:v3
QBITTORRENT_IMAGE=lscr.io/linuxserver/qbittorrent:5.2.4
