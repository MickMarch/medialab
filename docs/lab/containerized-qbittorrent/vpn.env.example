# Copy to secrets/vpn.env (gitignored). Keep exactly one provider block.
# Switching providers = replace this file and `docker compose up -d gluetun`.
# qBittorrent, the probe and the scripts never change: the tunnel interface
# inside the namespace is always tun0.

# --- NordVPN (NordLynx is WireGuard; Nord issues a private key, not a file)
VPN_SERVICE_PROVIDER=nordvpn
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
SERVER_COUNTRIES=Canada
# Optional narrowing, see gluetun docs: SERVER_CITIES, SERVER_CATEGORIES

# --- Mullvad / Proton / AirVPN / IVPN with a downloaded WireGuard .conf
# Use the compose.wgfile.yml overlay and place the file at secrets/wg0.conf.
# VPN_SERVICE_PROVIDER=custom
# VPN_TYPE=wireguard

# --- Any provider gluetun knows natively (OpenVPN or WireGuard)
# See https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
# VPN_SERVICE_PROVIDER=mullvad
# VPN_TYPE=wireguard
# WIREGUARD_PRIVATE_KEY=
# WIREGUARD_ADDRESSES=
# SERVER_COUNTRIES=
