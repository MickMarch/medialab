# Root .env: the values compose itself interpolates. Service configuration
# lives in each service's own .env; VPN provider settings in gluetun/vpn.env.

# Host media root. Bind-mounted at /media into qBittorrent and the orchestrator.
# Downloads land in <root>/_incoming/<Movies|Shows>; the orchestrator moves
# them into <root>/<Movies|Shows> once named.
MEDIA_HOST_DIR=F:/Media

# Host directory for Jellyfin Discover placeholders (requests from inside
# Jellyfin clients). Bind-mounted at /discover into medialab-jellyfin, which
# writes one small folder per title. Keep it outside the media root so the
# real libraries never index a placeholder. Jellyfin's "Discover Movies" and
# "Discover Shows" libraries point at its Movies and Shows subfolders.
DISCOVER_HOST_DIR=F:/MedialabDiscover

# Compose network subnet. gluetun allows egress to it so the completion hook
# and the orchestrator can cross the namespace boundary. Pick one that does
# not overlap your LAN or the VPN provider's tunnel range (often 10.x).
MEDIALAB_SUBNET=172.28.77.0/24

# qBittorrent WebUI, published on 127.0.0.1 only. The API key for it is in
# torrent-downloader/.env (QB_API_KEY) and is seeded by bin/medialab-qbt-provision.sh.
QBT_WEBUI_PORT=8090

# Search plugins installed into qBittorrent by the provision script, from the
# official qbittorrent/search-plugins repository. Comma-separated engine names.
QBT_SEARCH_PLUGINS=eztv,limetorrents,piratebay,solidtorrents,torlock,torrentproject,torrentscsv

# Timezone for gluetun and qBittorrent logs.
TZ=America/Toronto
